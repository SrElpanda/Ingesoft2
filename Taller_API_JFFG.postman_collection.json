    {
      "name": "Traer_filtro_nombre",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"El nombre devuelto coincide con la variable de entorno\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    var expectedName = pm.environment.get(\"pkmn_name\");\r",
              "    pm.expect(jsonData.name).to.eql(expectedName.toLowerCase());\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{url_base}}pokemon/{{pkmn_name}}",
          "host": [
            "{{url_base}}pokemon"
          ],
          "path": [
            "{{pkmn_name}}"
          ]
        }
      },
      "response": []
    },
